{
  "name": "circuitlens-server",
  "version": "0.1.0",
  "private": true,
  "description": "CircuitLens backend and Meta Model API connectivity service",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:api": "tsx src/test-connection.ts",
    "test:validation": "tsx src/test-diagnosis-validation.ts",
    "test:endpoint": "tsx src/test-endpoint.ts",
    "test:reassessment-validation": "tsx src/test-reassessment-validation.ts",
    "test:reassessment-endpoint": "tsx src/test-reassessment-endpoint.ts",
    "test": "npm run test:validation && npm run test:endpoint && npm run test:reassessment-validation && npm run test:reassessment-endpoint"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.86.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
