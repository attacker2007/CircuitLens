# ==============================================================================
# CircuitLens Server Environment Configuration Template
# ==============================================================================

# Model Provider Selection: "meta" (default) or "baseten"
# When omitted, defaults to "meta" (https://api.meta.ai/v1 with muse-spark-1.3)
MODEL_PROVIDER=meta

# Meta Model API Key (required when MODEL_PROVIDER=meta or omitted)
# Replace placeholder with your actual Meta Model API key
MODEL_API_KEY=your_meta_model_api_key_here

# Baseten API Key (required when MODEL_PROVIDER=baseten)
# Replace placeholder with your actual Baseten API key
BASETEN_API_KEY=your_baseten_api_key_here

# Optional: Custom endpoint URL override (defaults to provider standard if omitted)
# - Meta default:    https://api.meta.ai/v1
# - Baseten default: https://inference.baseten.co/v1
# MODEL_BASE_URL=https://inference.baseten.co/v1

# Optional: Custom model identifier override (defaults to provider standard if omitted)
# - Meta default:    muse-spark-1.3
# - Baseten default: meta-models/muse-spark-open-1026
# MODEL_NAME=meta-models/muse-spark-open-1026

# Optional: Upstream model request timeout in milliseconds (default: 75000)
# Must be an integer between 5000 and 300000 ms.
# MODEL_TIMEOUT_MS=75000

# Backend server listening port (default: 4000)
PORT=4000
